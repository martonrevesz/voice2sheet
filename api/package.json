{
  "name": "voice2sheet-api",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.x"
  },
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start --typescript",
    "test": "npm run build && node --test dist/src/test/*.test.js",
    "test:openai": "node scripts/test-openai.mjs"
  },
  "dependencies": {
    "@azure/functions": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
